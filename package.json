{
  "name": "defied",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=11.24.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "validate": "node scripts/validate-workspace.mjs",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo -F web test:e2e",
    "dev:web": "turbo -F web dev",
    "dev:docs": "turbo -F docs dev",
    "build:docs": "turbo -F docs build",
    "check:docs": "turbo -F docs check-types",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @defied/db db:push",
    "db:studio": "turbo -F @defied/db db:studio",
    "db:generate": "turbo -F @defied/db db:generate",
    "db:migrate": "turbo -F @defied/db db:migrate"
  },
  "dependencies": {
    "@defied/env": "workspace:^",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@defied/config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.1",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.24.0"
}