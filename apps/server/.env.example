# Environment
APP_ENV="development"
NODE_ENV="development"
SERVER_PORT=3005

# Database
DATABASE_URL="mysql://username:password@localhost:3306/defied"

# Authentication
AUTH_SECRET="replace-with-at-least-32-characters"
AUTH_URL="http://localhost:3005"
AUTH_ZITADEL_ID="your-zitadel-client-id"
AUTH_ZITADEL_SECRET="your-zitadel-client-secret"
AUTH_ZITADEL_ISSUER="https://your-zitadel-issuer"
AUTH_ZITADEL_AUTHORIZATION_ENDPOINT="https://your-zitadel-issuer/oauth/v2/authorize"
AUTH_ZITADEL_TOKEN_ENDPOINT="https://your-zitadel-issuer/oauth/v2/token"
AUTH_ZITADEL_USERINFO_ENDPOINT="https://your-zitadel-issuer/oidc/v1/userinfo"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# CORS
CORS_ORIGIN="http://localhost:3001"

# SMTP (Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@yourdomain.com"